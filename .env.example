APP_NAME=AnahnuClub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Let search engines index the site: true only at anahnu.club itself, never on test.anahnu.club.
SEO_INDEXABLE=false

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The main administrator (cannot be blocked, demoted or deleted); empty = the oldest admin account.
SUPER_ADMIN_EMAIL=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=anahnu
DB_USERNAME=anahnu
DB_PASSWORD=

JOOMLA_DB_HOST=127.0.0.1
JOOMLA_DB_PORT=3306
JOOMLA_DB_DATABASE=joomla
JOOMLA_DB_USERNAME=joomla
JOOMLA_DB_PASSWORD=
JOOMLA_DB_PREFIX=fsgfx_

TRANSLATION_DRIVER=null
TRANSLATION_ON_DEMAND=false
TRANSLATION_DAILY_CHARS=0
ANTHROPIC_API_KEY=
ANTHROPIC_TRANSLATION_MODEL=claude-haiku-5-5
DEEPL_API_KEY=
GEMINI_API_KEY=
GOOGLE_TRANSLATE_KEY=
MICROSOFT_TRANSLATOR_KEY=
MICROSOFT_TRANSLATOR_REGION=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=
MYMEMORY_EMAIL=
# Order of translators until changed in the admin, e.g. deepl,gemini,mymemory
# TRANSLATION_PROVIDERS=
GEMINI_TRANSLATION_MODEL=gemini-flash-lite-latest

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Letters (email confirmation, password reset). With "log" they only land in storage/logs/laravel.log;
# for real sending set MAIL_MAILER=smtp and the mail server's host, port, user and password.
MAIL_MAILER=log
# The club's mail server (port 465 means SSL). Username is the full mailbox address.
MAIL_HOST=mail.anahnu.club
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@anahnu.club"
MAIL_FROM_NAME="${APP_NAME}"
# every new member is reported to this address; leave empty to turn it off
# Letters about new members go here; several addresses are split by commas
MAIL_TEAM_ADDRESS=team@anahnu.club

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=AnahnuClub

# Signing in with Google and Facebook: a button shows only when both values are set.
# Callback addresses to register with the services: APP_URL/auth/google/callback and APP_URL/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Contact form messages are also emailed here
CONTACT_EMAIL=team@anahnu.club

# Video calls: a TURN relay for members whose networks block direct connections (optional, e.g. metered.ca)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# or Cloudflare TURN (dash.cloudflare.com, Realtime, TURN Server): the Turn Token ID and the API Token
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Reads link cards for sites that turn this server away; empty turns it off (free: 50 links a day).
LINK_PREVIEW_FALLBACK=https://api.microlink.io/
